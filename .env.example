# Copy to .env.local for local development (never commit it). All values are public: they end up in
# the JavaScript bundle, so never put secrets here.

# Origin of blog-backend. Leave empty for demo mode (mock API, no backend needed).
VITE_API_BASE_URL=

# "true" lets search engines index the site. CI sets it for production deploys with a real API.
VITE_INDEXABLE=
